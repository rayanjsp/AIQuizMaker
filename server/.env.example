# ============================================================
# AIQuizMaker — Variables d'environnement serveur
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Serveur ---
PORT=3000

# --- Base de données (Prisma / MySQL) ---
DATABASE_URL="mysql://root:password@localhost:3306/aiquizmaker"

# --- Sécurité ---
JWT_SECRET=change_me_to_a_long_random_string

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Sélection du fournisseur IA ---
# Optionnel. Si absent, la première clé trouvée ci-dessous est utilisée automatiquement.
# Ordre de priorité automatique : deepseek > openai > openrouter
# Valeurs acceptées : deepseek | openai | openrouter
# AI_PROVIDER=openrouter

# --- DeepSeek (modèle : deepseek-chat) ---
# Obtenir une clé sur https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (modèle par défaut : gpt-4o-mini) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter (modèle gratuit par défaut : meta-llama/llama-3.3-8b-instruct:free) ---
# Obtenir une clé gratuite sur https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel : surcharger le modèle OpenRouter
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct
