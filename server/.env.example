# ============================================================
# AIQuizMaker — Variables d'environnement serveur
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Serveur ---
PORT=3000

# --- Base de données (Prisma / MySQL) ---
DATABASE_URL="mysql://root:password@localhost:3306/aiquizmaker"

# --- Sécurité ---
JWT_SECRET=change_me_to_a_long_random_string

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# ============================================================
# FOURNISSEUR IA
# ============================================================
# Optionnel : si absent, le premier provider dont la clé est
# présente est utilisé automatiquement.
# Valeurs acceptées : deepseek | openai | openrouter | groq | mistral | together | custom
# AI_PROVIDER=groq

# --- DeepSeek (modèle : deepseek-chat) ---
# https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (modèle : gpt-4o-mini) ---
# https://platform.openai.com
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter (modèle gratuit par défaut) ---
# https://openrouter.ai — accès à des centaines de modèles dont des gratuits
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel : surcharger le modèle (défaut : meta-llama/llama-3.3-8b-instruct:free)
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# --- Groq (très rapide, free tier disponible) ---
# https://console.groq.com — modèle : llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mistral AI (modèle : mistral-small-latest) ---
# https://console.mistral.ai
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Together AI (crédits offerts à l'inscription) ---
# https://api.together.ai
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Grok / xAI (modèle : grok-2-latest) ---
# https://console.x.ai
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic / Claude (modèle : claude-3-5-haiku-latest) ---
# https://console.anthropic.com — utilise le SDK Anthropic natif
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Custom : n'importe quel provider compatible OpenAI ---
# Exemples : Ollama (local), LM Studio, Perplexity, Cohere...
# AI_PROVIDER=custom
# AI_API_KEY=votre_cle_api
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3
